	LOC	Data_Segment
G1	GREG	@
G2	GREG
G3	GREG
G4	GREG
Text	BYTE	"Hello world!",10,0
	
N4	OCTA 10
N5	OCTA 10
N1	BYTE 47
N2	BYTE 69
N3	BYTE 10
N6  BYTE
